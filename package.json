{
  "name": "jiva",
  "version": "0.2.0",
  "private": true,
  "description": "A local personal wiki of images, videos, text and conversations.",
  "type": "module",
  "main": "src/main/main.js",
  "bin": {
    "jiva": "src/cli/main.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "cli": "node src/cli/main.js",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "node src/server/server.js --port 8765",
    "dev:desktop": "cross-env API_PORT=8765 EXTERNAL_API_URL=http://127.0.0.1:8765 VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k -n api,web,desktop -c teal,blue,magenta \"npm run dev:api\" \"npm run dev:web\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:8765/api/health && npm run dev:desktop\"",
    "start": "node src/server/server.js --port 8765 --open",
    "build": "vite build",
    "build:115": "node tools/build-115-bridge.mjs",
    "desktop": "electron .",
    "test": "node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\" \"test/ui/*.test.js\"",
    "check:arch": "node tools/check-architecture.mjs",
    "check": "node --check src/server/server.js && node --check src/main/main.js && node --check vite.config.js && npm run build && npm run test && npm run check:arch",
    "package:win": "npm run build && node tools/package-windows.mjs",
    "package:dir": "npm run build && node tools/package-windows.mjs --dir",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "pretest:ui": "npm run build",
    "test:ui": "node --test \"test/ui/*.test.js\""
  },
  "dependencies": {
    "playwright-core": "^1.56.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "smol-toml": "^1.8.0",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.11.6",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^25.1.8",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1",
    "yet-another-react-lightbox": "^3.33.0"
  },
  "build": {
    "appId": "local.jiva",
    "productName": "Jiva",
    "files": [
      "dist/**",
      "src/main/**",
      "src/cli/**",
      "src/agent/**",
      "config/organization.example.json",
      "config/video-analysis.example.json",
      "tools/visual-encoder/**",
      "src/server/**",
      "src/shared/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "src/renderer/public/brand/jiva.ico",
      "target": [
        "portable"
      ]
    },
    "asar": false
  }
}
